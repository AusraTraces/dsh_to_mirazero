{
  "name": "dsh-mirazero-bridge",
  "version": "0.6.0",
  "description": "Connect a DeepSeek Harness role-play character to a MiraZero model with a model-bound integration key. One isolated Session per public request, text and images, a single character-card switch, and a Chinese Settings page for the connection.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "ISOLATION.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1"
  ],
  "scripts": {
    "check": "node --check index.js",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mirazero",
    "roleplay",
    "bridge",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
